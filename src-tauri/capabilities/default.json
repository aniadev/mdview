{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/**/*.md" },
        { "path": "$HOME/**/*.markdown" },
        { "path": "$HOME/**/*.code-workspace" },
        { "path": "$HOME/.mdview/**" },
        { "path": "/tmp/mdview-*/**" }
      ]
    },
    "store:default",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    "store:allow-load",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "/tmp/**" },
        { "path": "/var/folders/**" },
        { "path": "$TEMP/**" }
      ]
    },
    "opener:allow-open-url",
    "updater:default",
    "process:default",
    "process:allow-restart"
  ]
}
