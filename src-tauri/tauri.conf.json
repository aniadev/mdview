{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mdview",
  "version": "1.2.0",
  "identifier": "dev.mdview.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "mdview",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Markdown workspace editor",
    "longDescription": "mdview is a focused desktop editor for Markdown files inside a project folder. Add a folder, see your .md files in a sidebar that dims directories without Markdown, edit with a split-pane source + GFM preview, jump between files with Cmd/Ctrl+P, and export rendered HTML to your browser. Supports math (KaTeX), Mermaid diagrams, dark and light themes. Built with Tauri.",
    "copyright": "© 2026 mdview",
    "publisher": "mdview",
    "homepage": "https://github.com/aniadev/mdview",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Document",
        "description": "Markdown text document",
        "role": "Editor"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English", "Vietnamese"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/aniadev/mdview/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDMzRENUMyMTFCNDdDQUEKUldTcWZMUVJ3dFUwZk5YbURUekxhRnhyaHpJb0JKZlFaQ2JQYnFCNW9YNGRKckRtaXNCSUhQY3AK"
    }
  }
}
